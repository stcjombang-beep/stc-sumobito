rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn()
        && request.auth.uid == '5ZQ0VcSeK6XqaYr3ZVmC60eUcO43'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isBranch() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function canOperate() {
      return isOwner() || isBranch();
    }

    // Katalog dibaca semua pengguna terautentikasi; cabang dapat input barang.
    match /barang/{docId} {
      allow read: if canOperate();
      allow create, update: if canOperate();
      allow delete: if isOwner();
    }
    match /kategori/{docId} {
      allow read: if canOperate();
      allow write: if isOwner();
    }

    // Operasional cabang dapat berjalan tanpa persetujuan perangkat dari OWNER.
    match /orders/{docId} { allow read, write: if canOperate(); }
    match /mutasi/{docId} { allow read, write: if canOperate(); }
    match /returns/{docId} { allow read, write: if canOperate(); }

    // Data keuangan dan pengaturan tetap khusus OWNER.
    match /pengaturan/{docId} {
      allow read: if canOperate();
      allow write: if isOwner();
    }
    match /penjualan/{docId} { allow read, write: if isOwner(); }
    match /angsuran/{docId} { allow read, write: if isOwner(); }

    // Tidak ada akses ke koleksi lain secara default.
    match /{document=**} { allow read, write: if false; }
  }
}
